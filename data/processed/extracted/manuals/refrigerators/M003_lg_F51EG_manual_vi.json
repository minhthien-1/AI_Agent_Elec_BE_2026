      "blocks": [
        {
          "page_number": 19,
          "block_index": 1,
          "text": "Ng\u001fn c\u001fa t\u001f l\u001fnh",
          "bbox": [
            77.72460174560547,
            394.4866027832031,
            136.68194580078125,
            404.7427062988281
          ],
          "kind": "text",
          "metadata": {}
        },
        {
          "page_number": 19,
          "block_index": 2,
          "text": "Dùng để bảo quản các gói thực phẩm nhỏ, đồ uống và hộp đựng nước sốt.",
          "bbox": [
            77.9531021118164,
            405.18304443359375,
            371.64801025390625,
            416.7297058105469
          ],
          "kind": "text",
          "metadata": {}
        },
        {
          "page_number": 19,
          "block_index": 3,
          "text": "K\u001f t\u001f l\u001fnh",
          "bbox": [
            77.72460174560547,
            424.4612731933594,
            111.75337982177734,
            434.7173767089844
          ],
          "kind": "text",
          "metadata": {}
        },
        {
          "page_number": 19,
          "block_index": 4,
          "text": "Dùng để bảo quản thực phẩm tươi và thực phẩm cần làm lạnh. \nNên đặt các loại thực phẩm có hàm lượng độ ẩm cao ở phía trước kệ.",
          "bbox": [
            77.9531021118164,
            435.5596923828125,
            352.935546875,
            457.25726318359375
          ],
          "kind": "text",
          "metadata": {}
        },
        {
          "page_number": 19,
          "block_index": 5,
          "text": "Ng\u001fn rau c\u001f dung tích l\u001fn",
          "bbox": [
            77.72460174560547,
            463.51025390625,
            175.9811553955078,
            473.766357421875
          ],
          "kind": "text",
          "metadata": {}
        },
        {
          "page_number": 19,
          "block_index": 6,
          "text": "Dùng để bảo quản thực phẩm tươi sống và thực phẩm cần làm lạnh.",
          "bbox": [
            77.9531021118164,
            475.0298156738281,
            344.3885498046875,
            486.57647705078125
          ],
          "kind": "text",
          "metadata": {}
        },
        {
          "page_number": 19,
          "block_index": 7,
          "text": "Ng\u001fn rau c\u001f dung tích l\u001fn",
          "bbox": [
            78.6734390258789,
            495.9001159667969,
            176.92999267578125,
            506.1562194824219
          ],
          "kind": "text",
          "metadata": {}
        },
        {
          "page_number": 19,
          "block_index": 8,
          "text": "Dùng để bảo quản thực phẩm tươi và thực phẩm cần làm lạnh. \nNên đặt các loại thực phẩm có hàm lượng độ ẩm cao ở phía trước ngăn.",
          "bbox": [
            77.9531021118164,
            508.6970520019531,
            360.7214660644531,
            530.3946533203125
          ],
          "kind": "text",
          "metadata": {}
        }
      ],
      "metadata": {
        "rotation": 0
      }
    },
    {
      "page_number": 20,
      "width": 505.0,
      "height": 680.0,
      "blocks": [
        {
          "page_number": 20,
          "block_index": 1,
          "text": "Ng\u001fn Nhi\u001ft \u001f\u001f Bi\u001fn \u001f\u001fi",
          "bbox": [
            78.74220275878906,
            101.40965270996094,
            157.34918212890625,
            111.66572570800781
          ],
          "kind": "text",
          "metadata": {}
        },
        {
          "page_number": 20,
          "block_index": 2,
          "text": "Nút điều chỉnh cho phép bạn thay đổi cài đặt để bảo quản rau củ, trái cây, đồ uống hoặc thực \nphẩm tươi sống theo nhu cầu của bạn.",
          "bbox": [
            77.70999908447266,
            114.3109359741211,
            441.48699951171875,
            136.008544921875
          ],
          "kind": "text",
          "metadata": {}
        },
        {
          "page_number": 20,
          "block_index": 3,
          "text": "Thanh Gi\u001fa C\u001fa T",
          "bbox": [
            77.04000091552734,
            144.98143005371094,
            149.90216064453125,
            155.2375030517578
          ],
          "kind": "text",
          "metadata": {}
        },
        {
          "page_number": 20,
          "block_index": 4,
          "text": "Ngăn không cho khí lạnh trong tủ thoát ra ngoài.",
          "bbox": [
            77.70999908447266,
            157.3255157470703,
            264.9390563964844,
            168.8721923828125
          ],
          "kind": "text",
          "metadata": {}
        },
        {
          "page_number": 20,
          "block_index": 5,
          "text": "C\u001fnh Báo",
          "bbox": [
            85.80960083007812,
            182.33709716796875,
            152.24853515625,
            200.335693359375
          ],
          "kind": "text",
          "metadata": {}
        },
        {
          "page_number": 20,
          "block_index": 6,
          "text": "ể tránh nguy cơ trầy xước cửa hoặc làm gãy thanh giữa của cửa tủ, hãy đảm bảo rằng thanh \ngiữa luôn được gập lại khi đóng cửa tủ lạnh.",
          "bbox": [
            77.70999908447266,
            198.8089141845703,
            440.83953857421875,
            220.50650024414062
          ],
          "kind": "text",
          "metadata": {}
        },
        {
          "page_number": 20,
          "block_index": 7,
          "text": "Khay Ng\u001fn Ðông",
          "bbox": [
            77.04000091552734,
            240.8226776123047,
            146.5294647216797,
            251.07875061035156
          ],
          "kind": "text",
          "metadata": {}
        },
        {
          "page_number": 20,
          "block_index": 8,
          "text": "Dùng để lữu trữ thực phẩm đông lạnh đóng gói nhỏ hoặc các loại thực phẩm thường dùng. \nKhay trượt giúp bạn dễ dàng lấy ra và sử dụng thuận tiện hơn.",
          "bbox": [
            77.70999908447266,
            253.42933654785156,
            433.18487548828125,
            275.1269226074219
          ],
          "kind": "text",
          "metadata": {}
        },
        {
          "page_number": 20,
          "block_index": 9,
          "text": "Ng\u001fn Kéo Ðông",
          "bbox": [
            77.04000091552734,
            283.1322021484375,
            139.33554077148438,
            293.3883056640625
          ],
          "kind": "text",
          "metadata": {}
        },
        {
          "page_number": 20,
          "block_index": 10,
          "text": "Dùng để bảo quản thực phẩm đông lạnh trong thời gian dài.",
          "bbox": [
            77.70999908447266,
            294.9212341308594,
            312.5206298828125,
            306.4678955078125
          ],
          "kind": "text",
          "metadata": {}
        },
        {
          "page_number": 20,
          "block_index": 11,
          "text": "èn LED Chi\u001fu Sáng",
          "bbox": [
            77.04000091552734,
            323.138671875,
            154.2064208984375,
            333.394775390625
          ],
          "kind": "text",
          "metadata": {}
        },
        {
          "page_number": 20,
          "block_index": 12,
          "text": "èn LED chiếu sáng đều toàn bộ bên trong tủ lạnh, giúp dễ dàng quan sát thực phẩm.",
          "bbox": [
            77.70999908447266,
            335.48260498046875,
            411.349365234375,
            347.0292663574219
          ],
          "kind": "text",
          "metadata": {}
        }
      ],
      "metadata": {
        "rotation": 0
      }
    },
    {
      "page_number": 21,
      "width": 505.0,
      "height": 680.0,
      "blocks": [
        {
          "page_number": 21,
          "block_index": 1,
          "text": "Ng\u001fn mát\nNhấn nút này nhiều lần để chọn nhiệt độ mong muốn trong khoảng từ 2 °C đến 8 °C.\nNhiệt độ mặc định của ngăn mát là 5 °C.",
          "bbox": [
            82.05180358886719,
            456.0912780761719,
            410.7416076660156,
            488.48602294921875
          ],
          "kind": "text",
          "metadata": {}
        },
        {
          "page_number": 21,
          "block_index": 2,
          "text": "Ng\u001fn \u001fông\nNhấn nút này nhiều lần để chọn nhiệt độ mong muốn trong khoảng từ -24 °C đến -15 °C.\nNhiệt độ mặc định của ngăn đông là -18 °C.",
          "bbox": [
            82.05180358886719,
            507.0048522949219,
            426.2959289550781,
            539.400146484375
          ],
          "kind": "text",
          "metadata": {}
        },
        {
          "page_number": 21,
          "block_index": 3,
          "text": "FRESH CONVERTER+\nNhấn để chuyển đổi giữa các chế độ: Rau củ, Trái cây, Cá và Thịt.",
          "bbox": [
            82.05180358886719,
            555.3482055664062,
            340.4934387207031,
            577.5919799804688
          ],
          "kind": "text",
          "metadata": {}
        }
      ],
      "metadata": {
        "rotation": 0
      }
    },
    {
      "page_number": 22,
      "width": 505.0,
      "height": 680.0,
      "blocks": [
        {
          "page_number": 22,
          "block_index": 1,
          "text": "Làm Ðông Nhanh",
          "bbox": [
            79.6416015625,
            100.09715270996094,
            151.04598999023438,
            110.35322570800781
          ],
          "kind": "text",
          "metadata": {}
        },
        {
          "page_number": 22,
          "block_index": 2,
          "text": "Chức năng này giúp làm đông nhanh một lượng lớn đá hoặc thực phẩm đông lạnh.\nMỗi lần nhấn nút, chức năng này sẽ lần lượt bật và tắt.\nChức năng này sẽ tự động tắt sau một khoảng thời gian nhất định.",
          "bbox": [
            79.87010192871094,
            110.7943344116211,
            402.62664794921875,
            142.64288330078125
          ],
          "kind": "text",
          "metadata": {}
        },
        {
          "page_number": 22,
          "block_index": 3,
          "text": "L\u001fu Ý",
          "bbox": [
            67.39550018310547,
            173.998779296875,
            99.87001037597656,
            188.17880249023438
          ],
          "kind": "text",
          "metadata": {}
        },
        {
          "page_number": 22,
          "block_index": 4,
          "text": "Nhiệt độ bên trong thực tế có thể thay đổi tùy thuộc vào tình trạng thực phẩm, \nvì nhiệt độ hiển thị chỉ là giá trị mục tiêu chứ không phải nhiệt độ thực tế bên trong thiết bị.",
          "bbox": [
            79.87010192871094,
            187.1145782470703,
            429.05511474609375,
            208.81216430664062
          ],
          "kind": "text",
          "metadata": {}
        },
        {
          "page_number": 22,
          "block_index": 5,
          "text": "Smart\nTrong chế độ Thông minh, nhiệt độ của ngăn mát và ngăn đông được tự động cài đặt lần lượt \nlà 5 ℃ và -18 ℃.",
          "bbox": [
            79.6416015625,
            231.60887145996094,
            445.9128112792969,
            264.00360107421875
          ],
          "kind": "text",
          "metadata": {}
        },
        {
          "page_number": 22,
          "block_index": 6,
          "text": "Vacation\nTrong chế độ Nghỉ, ngăn mát sẽ tạm ngừng hoạt động, nhưng ngăn đông vẫn hoạt động bình \nthường.",
          "bbox": [
            79.6416015625,
            277.63134765625,
            444.65313720703125,
            310.026123046875
          ],
          "kind": "text",
          "metadata": {}
        },
        {
          "page_number": 22,
          "block_index": 7,
          "text": "Khoá B\u001fng Ði\u001fu Khi\u001fn\nể mở khóa, nhấn và giữ nút trong 3 giây",
          "bbox": [
            79.6416015625,
            330.2924499511719,
            235.40440368652344,
            352.53631591796875
          ],
          "kind": "text",
          "metadata": {}
        },
        {
          "page_number": 22,
          "block_index": 8,
          "text": "L\u001fu Ý",
          "bbox": [
            66.4533462524414,
            378.6608581542969,
            98.9278564453125,
            392.84088134765625
          ],
          "kind": "text",
          "metadata": {}
        },
        {
          "page_number": 22,
          "block_index": 9,
          "text": "Khi lau chùi, nếu tay hoặc da chạm vào bảng điều khiển, các nút có thể bị kích hoạt.",
          "bbox": [
            79.87010192871094,
            391.5666198730469,
            405.6885681152344,
            403.11328125
          ],
          "kind": "text",
          "metadata": {}
        },
        {
          "page_number": 22,
          "block_index": 10,
          "text": "Để bảo quản thực phẩm tốt nhất, nên điều chỉnh tăng hoặc giảm 1 °C so với nhiệt độ mặc định \ncủa từng ngăn.",
          "bbox": [
            79.87010192871094,
            407.25421142578125,
            449.4646301269531,
            428.9517822265625
          ],
          "kind": "text",
          "metadata": {}
        },
        {
          "page_number": 22,
          "block_index": 11,
          "text": "Nhiệt độ hiển thị là nhiệt độ mục tiêu, không phải nhiệt độ thực tế bên trong thiết bị.",
          "bbox": [
            79.87010192871094,
            433.4306945800781,
            402.3030090332031,
            444.97735595703125
          ],
          "kind": "text",
          "metadata": {}
        },
        {
          "page_number": 22,
          "block_index": 12,
          "text": "Nhiệt độ thực tế của thiết bị phụ thuộc vào lượng và loại thực phẩm bên trong.",
          "bbox": [
            79.87010192871094,
            449.8498229980469,
            383.7567443847656,
            461.396484375
          ],
          "kind": "text",
          "metadata": {}
        },
        {
          "page_number": 22,
          "block_index": 13,
